{
  "name": "do-manager-admin-hooks",
  "version": "1.1.16",
  "description": "Admin hooks for Cloudflare Durable Objects - enables DO Manager integration",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --tsconfig tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck"
  },
  "keywords": [
    "cloudflare",
    "durable-objects",
    "workers",
    "admin",
    "management",
    "do-manager"
  ],
  "author": "adamic.tech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neverinfamous/do-manager-admin-hooks.git"
  },
  "homepage": "https://do.adamic.tech",
  "bugs": {
    "url": "https://github.com/neverinfamous/do-manager-admin-hooks/issues"
  },
  "dependencies": {
    "ts-pattern": "^5.9.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4.0.0"
  }
}
